<VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>VPE_PhasingSTNL</defName>
    <label>Phase</label>
    <description>Use your Arts to phase, allowing you to avoid any incoming damage for a 10 sec duration. Dodging will still require time to get back into fighting position, Causing a slight stun when hit.</description>
