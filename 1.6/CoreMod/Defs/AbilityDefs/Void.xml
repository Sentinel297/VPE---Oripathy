<maintainForTicks>30</maintainForTicks>
<scale>0.5</scale>
</li>
    </modExtensions>
  </VEF.Abilities.AbilityDef>

<VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
<defName>VPE_BrainmeltSTNL</defName>
<label>Originium Mind-Control</label>
<chance>0</chance>
<description>Breaks the brain structure of the target and replaces it with an originium based crystal, effectively killing them and turning them into an originium zombie for your faction. Retains the capabilities of the host but infects them with the first few signs of curable oripathy.</description>
<iconPath>UI_Oripath-Y/Abilities/MindBreak</iconPath>
<abilityClass>VEF.Abilities.Ability_Blank</abilityClass>
<targetingParameters>
<canTargetSelf>True</canTargetSelf>
<canTargetAnimals>True</canTargetAnimals>
<canTargetMechs>True</canTargetMechs>
<canTargetHumans>True</canTargetHumans>
</targetingParameters>
<range>5</range>
<castTime>230</castTime>
<goodwillImpact>0</goodwillImpact>
<needsTicking>true</needsTicking>
<castSound>PsychicShockLanceCast</castSound>
<showUndrafted>true</showUndrafted>
<modExtensions>
<li Class="VanillaPsycastsExpanded.AbilityExtension_Psycast">
<path>VPE_Oripath-Y</path>
<level>4</level>
<order>1</order>
<psyfocusCost>0.6</psyfocusCost>
<entropyGain>60</entropyGain>
<prerequisites>
<li>VPE_PhasingSTNL</li>
</prerequisites>
</li>
 <li Class="VEF.Abilities.AbilityExtension_EffecterOnTarget">
<effecterDef>AgonyPulseExplosion</effecterDef>
<maintainForTicks>30</maintainForTicks>
<scale>0.5</scale>
</li>
      <li Class="VEF.Abilities.AbilityExtension_Hediff">
        <hediff>oripathySafeSTNL</hediff>
      </li>
<li Class="VanillaPsycastsExpanded.AbilityExtension_JoinFaction"/>
</modExtensions>
</VEF.Abilities.AbilityDef>
	
	<VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>VPE_DarknessSTNL</defName>
    <label>World Of Dark: Resurrecting-Oripathy</label>
    <description>Unleash a huge cloud of Originium dust high in the sky, causing it to resurrect dead creatures back to life in a berserk state.</description>
    <iconPath>UI_Oripath-Y/Abilities/OripathicStorm</iconPath>
